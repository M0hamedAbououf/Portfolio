# Contact form storage (Supabase project > Settings > API). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email alerts (resend.com > API Keys)
RESEND_API_KEY=
CONTACT_TO_EMAIL=mohabououf@gmail.com
# Until a domain is verified in Resend, keep the default sender:
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public site address, used for links shared on social media
NEXT_PUBLIC_SITE_URL=https://mohamed-abououf-portfolio.vercel.app
